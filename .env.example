# Resume Tailor environment configuration
#
# Copy to .env and replace only the placeholder values. Never commit .env.

# Required by the configured DeepSeek agents.
DEEPSEEK_API_KEY=your_deepseek_api_key

# Required by configured OpenAI model calls (for example, ATS optimization).
OPENAI_API_KEY=your_openai_api_key

# Optional: enables LangSmith tracing when observability is enabled in
# src/config/settings.yaml. Leave unset to run without tracing.
LANGSMITH_API_KEY=your_langsmith_api_key

# Optional: writes raw agent input/output checkpoints for local debugging.
# These logs can contain resume PII. Never enable this in production.
# DEBUG_CHECKPOINTS=0
